"""
Unit tests for rbl.config.steerer_geometry — no Qt, no hardware.

The steerer is a single installed unit, not a table of options, so these
tests pin the numbers of THAT unit against the manual.
"""
import pytest

from rbl.config import steerer_geometry as sg


def test_it_is_the_steerer_actually_on_the_beamline():
    assert sg.STEERER_MODEL == "2EA021441"
    assert sg.STEERER_SERIAL == "14578.1124"


def test_plate_geometry_matches_the_lab_deflection_sheet():
    # Hirst RHBL Deflection Information.xlsx, "Deflection on Sample":
    #   I8 = ((C8*10^3) * 12.5 * q) / (2 * 3.8 * E*10^6) * C9 * 2
    # 12.5 cm and 3.8 cm are baked into that formula; the per-plate rating
    # of this unit is 5 kV, not the ES10 assembly's 10 kV.
    assert sg.PLATE_LENGTH_CM == 12.5
    assert sg.PLATE_GAP_CM == 3.8
    assert sg.PLATE_WIDTH_CM == 10.2
    assert sg.ENTRANCE_APERTURE_CM == 2.54
    assert sg.PLATE_RATING_KV == 5.0


def test_drift_to_sample_matches_the_sheets_beamline_table():
    # SUM(F4:N4) of the TOTAL BEAMLINE LENGTH row - every component after
    # the steerer: DT 50 + XYSL 7.12 + BPM80 7.22 + FC50 7.25 + reducing
    # nipple 2.5 + GV 2.89 + bellows 5 + adapter 2.5 + chamber 13.
    assert sg.DRIFT_TO_SAMPLE_IN == pytest.approx(97.48)
    assert sg.DRIFT_TO_SAMPLE_CM == pytest.approx(247.5992)
    assert sg.DRIFT_TUBE_CM == pytest.approx(127.0)


def test_differential_rating_is_twice_the_per_plate_rating():
    # Push-pull drive: X+ at +V and X- at -V is 2V plate to plate.
    assert sg.DIFFERENTIAL_RATING_KV == 2.0 * sg.PLATE_RATING_KV


def test_dimensions_are_positive():
    for name in ("PLATE_LENGTH_CM", "PLATE_GAP_CM", "PLATE_WIDTH_CM",
                 "ENTRANCE_APERTURE_CM", "PLATE_RATING_KV"):
        assert getattr(sg, name) > 0, name


def test_describe_names_the_part_and_the_gap():
    text = sg.describe()
    assert sg.STEERER_MODEL in text
    assert "3.8" in text


def test_there_is_no_picker_left_to_get_wrong():
    assert not hasattr(sg, "STEERER_GEOMETRIES")
    assert not hasattr(sg, "DEFAULT_STEERER")


class TestPlatePositionsAlongTheBeam:
    """The two plate pairs are in series, so they do not deflect from the same
    place and the two axes do not share a drift.  See the plate-position
    section of steerer_geometry."""

    def test_the_plate_stack_fits_inside_the_insertion_length(self):
        stack = (2 * sg.PLATE_LENGTH_CM * 10.0
                 + sg.PLATE_XY_SEPARATION_CM * 10.0)
        assert stack < sg.STEERER_INSERTION_MM
        # The end spaces are derived, not assumed: two of them plus the stack
        # must be exactly the insertion length.
        assert (stack + 2 * sg.STEERER_END_SPACE_MM
                == pytest.approx(sg.STEERER_INSERTION_MM))
        assert sg.STEERER_END_SPACE_MM > 0

    def test_y_is_upstream_so_y_has_the_longer_drift(self):
        assert sg.Y_PLATES_UPSTREAM is True
        assert sg.PLATE_EXIT_TO_FLANGE_MM["Y"] > sg.PLATE_EXIT_TO_FLANGE_MM["X"]

    def test_the_gap_between_the_two_axes_is_one_plate_plus_the_separation(self):
        """The extra distance the upstream axis has flown is exactly the
        downstream plate pair plus the space before it -- nothing else."""
        gap = sg.PLATE_EXIT_TO_FLANGE_MM["Y"] - sg.PLATE_EXIT_TO_FLANGE_MM["X"]
        assert gap == pytest.approx(sg.PLATE_LENGTH_CM * 10.0
                                    + sg.PLATE_XY_SEPARATION_CM * 10.0)

    def test_drift_adds_the_axis_offset_to_the_plane(self):
        for axis in ("X", "Y"):
            assert sg.drift_mm_for(axis, 1000.0) == pytest.approx(
                1000.0 + sg.PLATE_EXIT_TO_FLANGE_MM[axis])

    def test_the_borrowed_separation_is_flagged_as_unmeasured(self):
        """It comes from the manual's ES5 row, not from this unit.  If someone
        measures it, they flip this flag as well as the number."""
        assert sg.PLATE_XY_SEPARATION_VERIFIED is False


class TestBeamlineAfterTheSteerer:
    """The component table, with BPM80 and XYSL swapped to match hardware."""

    def test_the_bpm_now_comes_before_the_slits(self):
        names = [n for n, _ in sg.BEAMLINE_AFTER_STEERER_IN]
        assert names.index("BPM80") < names.index("XYSL")

    def test_the_swap_did_not_change_the_total_length(self):
        """Reordering two components cannot change the drift to the sample, so
        every deflection figure the lab sheet has ever published still holds.
        If this ever fails, something was added or removed, not swapped."""
        total_in = sum(length for _n, length in sg.BEAMLINE_AFTER_STEERER_IN)
        assert total_in == pytest.approx(sg.DRIFT_TO_SAMPLE_IN)
        assert total_in * sg.MM_PER_IN == pytest.approx(sg.DRIFT_TO_SAMPLE_CM * 10.0)

    def test_planes_come_out_in_beam_order(self):
        planes = sg.beamline_planes_mm()
        zs = [z for _n, z, _k in planes]
        assert zs == sorted(zs)

    def test_x_slits_are_upstream_of_y_slits(self):
        names = [n for n, _z, _k in sg.beamline_planes_mm()]
        assert sg.X_SLITS_UPSTREAM is True
        assert names.index("X slits") < names.index("Y slits")

    def test_both_slit_planes_sit_inside_the_slit_housing(self):
        planes = sg.beamline_planes_mm()
        z_of = {n: z for n, z, _k in planes}
        body_mm = dict(sg.BEAMLINE_AFTER_STEERER_IN)[sg.SLIT_COMPONENT] * sg.MM_PER_IN
        xysl_exit = z_of[sg.SLIT_COMPONENT]
        xysl_entrance = xysl_exit - body_mm
        for axis in ("X slits", "Y slits"):
            assert xysl_entrance <= z_of[axis] <= xysl_exit

    def test_the_last_plane_is_the_sample_at_the_sheets_drift(self):
        name, z, _kind = sg.beamline_planes_mm()[-1]
        assert name == "Chamber to sample"
        assert z == pytest.approx(sg.DRIFT_TO_SAMPLE_CM * 10.0)

    def test_editing_a_length_moves_only_what_is_downstream_of_it(self):
        comps = list(sg.BEAMLINE_AFTER_STEERER_IN)
        before = {n: z for n, z, _k in sg.beamline_planes_mm(comps)}
        # Lengthen the drift tube, which is first: everything moves.
        comps[0] = (comps[0][0], comps[0][1] + 1.0)
        after = {n: z for n, z, _k in sg.beamline_planes_mm(comps)}
        for name in before:
            assert after[name] == pytest.approx(before[name] + sg.MM_PER_IN)

    def test_the_slit_plane_fractions_are_flagged_as_unmeasured(self):
        assert sg.SLIT_PLANE_FRACTIONS_VERIFIED is False
